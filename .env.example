# Telegram token from @BotFather. Keep this file private.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot.
AUTHORIZED_USER_IDS=
# Default polling interval in seconds (minimum 300).
POLL_INTERVAL_SECONDS=900
DATABASE_PATH=data/hardware_hunter.sqlite3
LOG_LEVEL=INFO
# Leave false until the Mercado Livre API authorization problem is resolved.
ENABLE_MERCADO_LIVRE=false
# MTProto credentials from my.telegram.org; keep private. First collector run asks for phone/code.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_PATH=data/telethon.session

